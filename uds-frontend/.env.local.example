# ---------------------------------------------------------------------------
# Browser-visible. Anything with NEXT_PUBLIC_ is compiled into the JS bundle
# and readable by anyone. Only keys designed to be public belong here.
# ---------------------------------------------------------------------------

# Supabase — Project Settings -> API. Use the PUBLISHABLE key (sb_publishable_…),
# never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — cloud name + an UNSIGNED upload preset
# (Settings -> Upload -> Upload presets -> Signing mode: Unsigned).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Server-only. No NEXT_PUBLIC_ prefix — these must never reach the browser.
# ---------------------------------------------------------------------------

# Groq — powers /api/llm/generate and /api/llm/guidance, free tier.
# Get one at console.groq.com/keys. Set it in Vercel too, as a plain
# (non-public) Environment Variable.
GROQ_API_KEY=
